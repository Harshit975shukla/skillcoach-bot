# Template only. Supply values via a secret manager/environment; .env is NOT auto-loaded.
# Never paste secrets into chat or commit them. Private PostgreSQL, not the dashboard, is authoritative.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# For Supabase's private CA: certs/supabase-ca-2021.crt (resolved inside the package).
# Other providers may use their own trusted absolute CA path or leave unset for libpq defaults.
DATABASE_CA_CERT_FILE=
TELEGRAM_BOT_TOKEN=
# Single positive private-chat/user ID. CHAT_ID is a legacy alias; OWNER_ID takes precedence.
OWNER_ID=
# Invite-only administration uses the same owner. No other user can grant access.
TELEGRAM_BOT_USERNAME=
# Telegram Mini App served by this bot; never a per-user URL parameter.
PRIVATE_DASHBOARD_URL=
# Bounded free-tier group, including the owner; higher values do not guarantee free-tier capacity.
MAX_LEARNERS=10
# Public /join accepts verified Telegram access requests; owner approval still required.
# False retains invitation-only admission. Existing learning is never reset.
ACCESS_REQUESTS_ENABLED=false
DAILY_AI_OPERATIONS=40
# Off until a specific voice passes licensing and listening acceptance. No automatic robotic fallback.
NARRATION_ENABLED=false
# Required on Vercel: 32-256 random URL-safe characters, configured identically with setWebhook.
TELEGRAM_WEBHOOK_SECRET=
# The only AI provider. Coaching prompts can hold private context, so there is no fallback to another
# provider; if Groq is unavailable, AI work waits and is retried. Consider Groq's Zero Data Retention setting.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional publishing. Actions maps the GH_PAT secret to GITHUB_TOKEN.
GITHUB_TOKEN=
DASHBOARD_REPO=owner/dashboard-repository
DASHBOARD_PATH=docs/data.json
DASHBOARD_URL=https://owner.github.io/dashboard-repository
# Hands-on labs. False stops new lab assignments, checks and the next-week lab gate; lessons and quizzes continue.
LABS_ENABLED=true
LABS_TEMPLATE_REPO=Harshit975shukla/skillcoach-labs
# Optional: fine-grained token with NO repository permissions, used only for GitHub API rate limits. Never GH_PAT.
LABS_GITHUB_TOKEN=
# Vercel-only on-time slot trigger. Vercel sends CRON_SECRET (32+ random characters) as a Bearer token.
CRON_SECRET=
SCHEDULER_REPO=owner/skillcoach-repository
# Optional: token allowed to dispatch this repository's workflows (Actions: write); falls back to GITHUB_TOKEN.
# In web mode it also starts the recovery worker for a requested lesson's video (fixed workflow on main,
# at most once per 4 minutes and 48 times a day).
SCHEDULER_GITHUB_TOKEN=
# Web + email fallback while Telegram is unavailable. telegram (default) changes nothing; web makes
# learners sign in at WEB_APP_URL/web with emailed codes, shows bot messages and lesson videos in a
# private web inbox and emails scheduled lessons and quizzes. Web mode requires every setting below.
# both = web mode plus Telegram copies through TELEGRAM_BOT_TOKEN's bot, for people who have messaged
# it (needs migration 015 and TELEGRAM_LEGACY_BOT_ID; see the README before enabling).
DELIVERY_CHANNEL=telegram
# Both mode only: the numeric ID (the digits before ":" in its token) of the bot whose Telegram updates
# are already recorded. Use the configured bot's own ID if it is that same bot with a new token.
TELEGRAM_LEGACY_BOT_ID=
# This app's HTTPS origin, without a path, e.g. https://skillcoach-bot-seven.vercel.app
WEB_APP_URL=
# The owner's sign-in address for /web and where admin PINs go in web mode. Keep private.
OWNER_EMAIL=
# Sender, optionally "SkillCoach <address>". With Gmail, use the same account as SMTP_USERNAME.
EMAIL_FROM=
# Gmail: smtp.gmail.com, port 587, your address and a Google app password (2-Step Verification on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional notifications for the installable web app (web mode only). One VAPID key pair, base64url;
# generate it with: python -c "from skillcoach.web_push import generate_keys; print(generate_keys())"
# The private key is a secret. Leave both empty to keep notifications off.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Tests only: never point this at a production database.
TEST_DATABASE_URL=
