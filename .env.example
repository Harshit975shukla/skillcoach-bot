# Template only. Supply values via a secret manager/environment; .env is NOT auto-loaded.
# Never paste secrets into chat or commit them. Private PostgreSQL, not the dashboard, is authoritative.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# For Supabase's private CA: certs/supabase-ca-2021.crt (resolved inside the package).
# Other providers may use their own trusted absolute CA path or leave unset for libpq defaults.
DATABASE_CA_CERT_FILE=
TELEGRAM_BOT_TOKEN=
# Single positive private-chat/user ID. CHAT_ID is a legacy alias; OWNER_ID takes precedence.
OWNER_ID=
# Invite-only administration uses the same owner. No other user can grant access.
TELEGRAM_BOT_USERNAME=
# Telegram Mini App served by this bot; never a per-user URL parameter.
PRIVATE_DASHBOARD_URL=
# Bounded free-tier group, including the owner; higher values do not guarantee free-tier capacity.
MAX_LEARNERS=10
DAILY_AI_OPERATIONS=40
# Off until a specific voice passes licensing and listening acceptance. No automatic robotic fallback.
NARRATION_ENABLED=false
# Required on Vercel: 32-256 random URL-safe characters, configured identically with setWebhook.
TELEGRAM_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional publishing. Actions maps the GH_PAT secret to GITHUB_TOKEN.
GITHUB_TOKEN=
DASHBOARD_REPO=owner/dashboard-repository
DASHBOARD_PATH=docs/data.json
DASHBOARD_URL=https://owner.github.io/dashboard-repository
# Tests only: never point this at a production database.
TEST_DATABASE_URL=
