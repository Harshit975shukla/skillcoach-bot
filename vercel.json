{
  "regions": ["hnd1"],
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/webhook.py": {
      "maxDuration": 60,
      "includeFiles": "skillcoach/course_data/**"
    }
  },
  "crons": [
    { "path": "/cron/lesson", "schedule": "0 2 * * 1-5" },
    { "path": "/cron/quiz", "schedule": "0 11 * * 1-5" },
    { "path": "/cron/weekly", "schedule": "0 2 * * 6" },
    { "path": "/cron/review", "schedule": "0 3 * * 0" }
  ]
}
