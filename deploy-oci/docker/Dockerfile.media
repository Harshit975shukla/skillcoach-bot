# SkillCoach media worker - renders the animated lesson videos (default product
# behaviour). Same app code as deploy-oci/docker/Dockerfile, plus Mermaid CLI,
# Chromium, ffmpeg, fonts and eSpeak NG. Used by the lesson and recovery CronJobs.
#
# Build with the REPO ROOT as the context:
#   docker build -f deploy-oci/docker/Dockerfile.media -t <image>:<tag> .

# ---- Stage 1: install the locked Node packages (Mermaid CLI + puppeteer) ----
FROM node:22-bookworm-slim AS node-deps
# Google ships no Chrome for Linux ARM64, so never download one; stage 2 uses
# Debian's Chromium instead.
ENV PUPPETEER_SKIP_DOWNLOAD=1
WORKDIR /deps
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---- Stage 2: the runtime image ----
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium \
    PATH="/app/node_modules/.bin:${PATH}"

# - chromium: the browser Mermaid draws in (ARM64 build available in Debian)
# - ffmpeg: turns rendered frames into MP4
# - fonts-dejavu-core: caption font used by skillcoach/story_renderer.py
# - espeak-ng: optional narration (NARRATION_ENABLED=true)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates chromium ffmpeg fonts-dejavu-core espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install -r requirements.txt

# Only the results of stage 1: the Node runtime and the locked packages.
COPY --from=node-deps /usr/local/bin/node /usr/local/bin/node
COPY --from=node-deps /deps/node_modules ./node_modules

RUN useradd --create-home --uid 10001 appuser
COPY --chown=appuser:appuser . .
USER appuser

# CronJobs set the command (python -m skillcoach.cli schedule lesson / recover).
CMD ["python", "-m", "skillcoach.cli", "recover"]
